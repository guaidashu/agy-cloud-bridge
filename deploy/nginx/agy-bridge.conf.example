# Nginx reverse proxy snippet for HTTPS termination in front of FRP / tunnel
# Replace bridge.example.com and certificate paths with your own.

server {
    listen 443 ssl http2;
    server_name bridge.example.com;

    ssl_certificate     /etc/letsencrypt/live/bridge.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:13190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long-poll wait timeout must exceed runtime.waitMaxSeconds (default 300s)
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
    }
}
